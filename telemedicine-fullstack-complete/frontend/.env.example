# Build-time Vite env vars (set in the Vercel project's Environment Variables)

# Absolute backend origin (e.g. https://telemedicine-api.vercel.app)
VITE_API_URL=https://your-backend.vercel.app
# Socket.io origin (same as VITE_API_URL for the Vercel deployment)
VITE_SOCKET_URL=https://your-backend.vercel.app

VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key