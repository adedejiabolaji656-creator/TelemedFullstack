# Local dev
PORT=5000
# MongoDB Atlas (production) — serverless-safe URI
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/telemedicine
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRE=30d

# Cloudinary
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Email (Gmail SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# App
# Must point at the deployed frontend (Vercel) so CORS + Socket.io allow it.
CLIENT_URL=https://your-frontend.vercel.app
ADMIN_EMAIL=admin@telemedicine.com