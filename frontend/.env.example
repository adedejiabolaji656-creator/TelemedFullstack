# Build-time Vite env vars (set in the Vercel project's Environment Variables)

# Absolute backend origin (must match the deployed backend, no trailing slash)
VITE_API_URL=https://telemedicine-backend-eta.vercel.app
# Socket.io origin (same as VITE_API_URL for the Vercel deployment)
VITE_SOCKET_URL=https://telemedicine-backend-eta.vercel.app